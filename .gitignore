# macOS
.DS_Store

# Датасеты, которые создаёт lib/prepare_data.py.
# ВСЕ .npz под data/: data.npz для CA на три года весит 30 ГБ, и один
# неосторожный `git add -A` превратил бы репозиторий в мусор.
data/**/*.npz
data/**/*.h5
data/**/*.npy
data/SD/*.csv

# А вот meta-файлы с координатами датчиков нужны в репозитории: по ним
# строится индекс патчинга, и без них проект не запустится на новой машине.
!data/**/*meta*.csv

# Логи прогонов: tqdm пишет по строке на каждые несколько батчей, за сутки
# набегают десятки мегабайт. Нужный лог всегда можно добавить принудительно:
#   git add -f run_logs/CA_final_20260812.log
run_logs/
*.log

# Результаты обучения
*.pt
*.pth
*.ckpt
checkpoints/
runs/
logs/

# Python/Jupyter
__pycache__/
.ipynb_checkpoints/
